# --- dynamodb (merge into .env.example) ---
# Set only for local dev/tests; unset in prod so the SDK targets real AWS endpoints.
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_REGION=us-east-1
# DynamoDB Local accepts any credentials; these dummies keep the SDK happy offline.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
