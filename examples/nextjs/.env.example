# .env.example — placeholder values ONLY (SEC-SECRETS-02).
# Copy to .env.local (gitignored) and fill in real values.
# Each variable: NAME=            # where to get the value
#
# NEXT_PUBLIC_ discipline (STK-NEXT-04): anything with that prefix is inlined into
# public JS. Secrets use unprefixed names and are read only in server code.
# GUESTBOOK_ADMIN_KEY=           # server-only example; generate locally, never NEXT_PUBLIC_
# NEXT_PUBLIC_SITE_NAME=         # safe: genuinely public display config only
