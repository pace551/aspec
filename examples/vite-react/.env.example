# .env.example — placeholder values ONLY (SEC-SECRETS-02).
# Copy to .env.local (gitignored) and fill in real values.
# Each variable: NAME=            # where to get the value
#
# VITE_ discipline (STK-VITE-07): anything with that prefix is inlined into public JS.
# A SPA has no server side — secrets live in the backing API, never here.
# VITE_API_BASE_URL=             # safe: public endpoint the browser calls anyway
